version: '3.8'

services:
  postgres:
    image: postgres:16-alpine
    container_name: dinedeck-postgres
    restart: always
    environment:
      POSTGRES_USER: dinedeck_user
      POSTGRES_PASSWORD: secure_password
      POSTGRES_DB: dinedeck_prod
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data

  redis:
    image: redis:7-alpine
    container_name: dinedeck-redis
    restart: always
    ports:
      - "6379:6379"
    volumes:
      - redisdata:/data

  backend:
    build: .
    container_name: dinedeck-backend
    restart: always
    depends_on:
      - postgres
      - redis
    environment:
      PORT: 8080
      HOST: 0.0.0.0
      NODE_ENV: production
      DATABASE_URL: "postgresql://dinedeck_user:secure_password@postgres:5432/dinedeck_prod?schema=public"
      REDIS_URL: "redis://redis:6379"
      JWT_SECRET: "dinedeck_super_secret_jwt_key_2026_india_production"
      JWT_REFRESH_SECRET: "dinedeck_super_secret_refresh_key_2026_india_production"
      CORS_ORIGIN: "*"
    ports:
      - "8080:8080"

volumes:
  pgdata:
  redisdata:
