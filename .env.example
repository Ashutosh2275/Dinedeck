# ==============================================================================
# DINEDECK ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting the stack in local development or Docker:
#   cp .env.example .env

# --- Server & Runtime ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*

# --- Database & Persistence ---
# Note: In Docker Compose, the host is 'postgres', while on host machine it is 'localhost'.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dinedeck_prod
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dinedeck_prod?schema=public"

# --- Cache & Pub/Sub ---
# Note: In Docker Compose, the host is 'redis', while on host machine it is 'localhost'.
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- Security & JWT Authentication ---
JWT_SECRET="dinedeck_super_secret_jwt_key_2026_india_production"
JWT_REFRESH_SECRET="dinedeck_super_secret_refresh_key_2026_india_production"

# --- External Payment & Notifications (Optional) ---
FCM_SERVER_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
