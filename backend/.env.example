# DINEDECK Production Environment Configuration Example
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
DATABASE_URL="postgresql://dinedeck_user:secure_password@localhost:5432/dinedeck_prod?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace_with_strong_random_jwt_secret_key"
JWT_REFRESH_SECRET="replace_with_strong_random_refresh_secret_key"
CORS_ORIGIN="*"
FCM_SERVER_KEY="optional_firebase_cloud_messaging_key"
RAZORPAY_KEY_ID="optional_razorpay_key_id"
RAZORPAY_KEY_SECRET="optional_razorpay_key_secret"
